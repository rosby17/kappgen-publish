{
  "manifest_version": 3,
  "name": "KappGen Uploader",
  "version": "1.7.6",
  "description": "Publie automatiquement tes vidéos finies sur YouTube (et Facebook) depuis un dossier de ton ordinateur.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "KappGen Uploader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "notifications",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.kappgen.com/*",
    "https://app.kappgen.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://business.facebook.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bridge.html"
      ],
      "matches": [
        "https://studio.youtube.com/*",
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://business.facebook.com/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "optional_permissions": [
    "debugger"
  ]
}
