{
  "manifest_version": 3,
  "name": "KappGen Publish",
  "version": "1.20.7",
  "minimum_chrome_version": "116",
  "description": "Publie tes vidéos et posts sur YouTube, Facebook, Instagram, TikTok, X et LinkedIn depuis un dossier local.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "KappGen Publish",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "debugger",
    "notifications",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.kappgen.com/*",
    "https://app.kappgen.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.github.com/*",
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://web.facebook.com/*",
    "https://business.facebook.com/*",
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.linkedin.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bridge.html"
      ],
      "matches": [
        "https://studio.youtube.com/*",
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://web.facebook.com/*",
        "https://business.facebook.com/*",
        "https://www.tiktok.com/*",
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
